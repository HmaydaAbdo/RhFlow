# ─────────────────────────────────────────────────────────────────────────────
# RH Flow — Backend environment variables (template)
#
# Copy this file to `.env` and fill in the real values.
# Never commit `.env` — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/rh_erp_db
DB_USERNAME=rh_admin
DB_PASSWORD=change-me
POSTGRES_DB=rh_erp_db

# ── pgAdmin (docker-compose only) ────────────────────────────────────────────
PGADMIN_EMAIL=admin@rh-erp.com
PGADMIN_PASSWORD=change-me

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be a strong, random string (>= 32 chars recommended, base64 ok).
# No default is provided — app refuses to start without it.
APP_JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed front-end origins.
# Dev default: http://localhost:4200
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── MinIO (object storage — CV files) ────────────────────────────────────────
#
# IMPORTANT — Un seul endpoint canonique, DNS override optionnel côté SDK :
#
#   ┌─ Pourquoi un seul endpoint ? ─────────────────────────────────────────────┐
#   │                                                                           │
#   │  Les presigned URLs MinIO sont signées via AWS Signature V4. La signature │
#   │  inclut le header Host dans les headers signés (X-Amz-SignedHeaders=host).│
#   │  Donc le hostname utilisé pour signer DOIT être le même que le hostname   │
#   │  envoyé dans la requête par le consommateur — sinon 403 SignatureDoesNotMatch.│
#   │                                                                           │
#   │  → Un seul MINIO_ENDPOINT, partagé par le SDK (signature) et par les      │
#   │    URLs retournées (consommées par docling-serve, browser).               │
#   └───────────────────────────────────────────────────────────────────────────┘
#
#   ┌─ Pourquoi le DNS override ? ──────────────────────────────────────────────┐
#   │                                                                           │
#   │  En dev local, l'endpoint canonique est host.docker.internal:9000 pour    │
#   │  que docling-serve (Docker) puisse résoudre les URLs via extra_hosts.     │
#   │  Mais Spring Boot tourne sur l'hôte et ne peut pas toujours joindre       │
#   │  host.docker.internal (Docker Desktop met parfois une IP LAN non routable,│
#   │  ou Windows Firewall bloque l'interface). Le DNS override route les       │
#   │  sockets TCP du SDK MinIO vers 127.0.0.1 sans toucher au hostname signé.  │
#   │                                                                           │
#   │  → MINIO_SDK_HOST_OVERRIDE=host.docker.internal=127.0.0.1                 │
#   │    Format : hostname=ip. Vide = pas d'override.                           │
#   └───────────────────────────────────────────────────────────────────────────┘
#
#   ┌─ Développement local ─────────────────────────────────────────────────────┐
#   │  MINIO_ENDPOINT=http://host.docker.internal:9000                          │
#   │  MINIO_SDK_HOST_OVERRIDE=host.docker.internal=127.0.0.1                   │
#   │  → SDK signe avec host=host.docker.internal:9000                          │
#   │  → SDK ouvre TCP vers 127.0.0.1:9000 (DNS override)                       │
#   │  → presigned URL contient host.docker.internal:9000, signature valide     │
#   │  → docling-serve résout host.docker.internal via extra_hosts (Docker)     │
#   └───────────────────────────────────────────────────────────────────────────┘
#
#   ┌─ Production (tout dans Docker / Kubernetes) ──────────────────────────────┐
#   │  MINIO_ENDPOINT=http://minio:9000                                         │
#   │  MINIO_SDK_HOST_OVERRIDE=                                                 │
#   │  → tous les services résolvent "minio" via le réseau Docker/K8s, pas     │
#   │    besoin d'override.                                                     │
#   └───────────────────────────────────────────────────────────────────────────┘
#
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_SDK_HOST_OVERRIDE=host.docker.internal=127.0.0.1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=hrflow-cvs

# ── Docling-serve (parsing PDF/DOCX → Markdown) ───────────────────────────────
# Démarrer via : docker compose up -d docling-serve
# Lancer manuellement : docker run -p 5001:5001 ds4sd/docling-serve:latest
DOCLING_URL=http://localhost:5001

# ── AI providers (fallback chain) ────────────────────────────────────────────
# Each provider can be disabled via `enabled: false` in application.yaml
# without removing the key. Leave blank to use the `dummy-*-key` default.
GROQ_API_KEY=
GOOGLE_AI_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPEN_ROUTER_API_KEY=
HF_API_KEY=

# ── AI debug logs ────────────────────────────────────────────────────────────
# Active logRequests / logResponses sur tous les providers LLM.
# ⚠ RGPD : ces logs contiennent le contenu intégral des CV (PII : nom, email,
# téléphone, parcours). Garder à false en prod, n'activer qu'en debug local.
APP_AI_DEBUG_LOGS=false
